# Copy this file to .env and fill in real values.
#   cp env.example .env
# Windows PowerShell: Copy-Item env.example .env

# ===== Celery broker / result backend =====
# Local dev uses SQLite. For production, switch to Redis:
#   CELERY_BROKER=redis://127.0.0.1:6379/0
#   CELERY_RESULT=redis://127.0.0.1:6379/0
CELERY_BROKER=sqla+sqlite:///./celery_broker.db
CELERY_RESULT=db+sqlite:///./celery_results.db

# ===== DeepSeek engine (dedicated vars) =====
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== OpenAI engine (OpenAI-compatible gateway) =====
OPENAI_API_KEY=sk-your-openai-key
# Leave OPENAI_BASE_URL empty to use the official OpenAI endpoint,
# or set it to any OpenAI-compatible gateway.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ===== CORS =====
# Comma-separated list of allowed frontend origins; "*" is for dev only.
CORS_ORIGINS=*

# PDF upload/parse limits
PDF_DATA_DIR=data
PDF_MAX_UPLOAD_BYTES=52428800
PDF_MAX_PAGES=200
PDF_MAX_BLOCKS=5000
PDF_MAX_TEXT_CHARS=500000
PDF_POLL_SECONDS=3600

# Free web engines (no API key)
# BING_TRANSLATOR_HOST=https://cn.bing.com
# GOOGLE_TRANSLATE_ENDPOINT=https://translate.googleapis.com/translate_a/single
# In networks where Google is blocked, configure HTTPS_PROXY / HTTP_PROXY.
